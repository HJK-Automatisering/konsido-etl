# ────────────────
# Azure Synapse (kilde-database)
# ────────────────
KONSIDO_AZURE_SYNAPSE="<workspace>-ondemand.sql.azuresynapse.net"
AZURE_SYNAPSE_BRUGERNAVN="<synapse-bruger>@<workspace>"
AZURE_SYNAPSE_ADGANGSKODE="<indsæt-adgangskode>"
AZURE_SYNAPSE_DATABASE="<kilde-database>"

# Skema i Synapse, som tabellerne læses fra
AZURE_SYNAPSE_SOURCE_SCHEMA_DEFAULT="<kilde-skema>"

# ODBC-driver og sikkerhed (kan normalt beholdes som default)
SYNAPSE_ODBC_DRIVER="ODBC Driver 17 for SQL Server"
SYNAPSE_ENCRYPT="yes"
SYNAPSE_TRUST_SERVER_CERTIFICATE="no"
SYNAPSE_TRUSTED_CONNECTION="no"

# ────────────────
# Lokal SQL Server (mål-database)
# ────────────────

# Mulighed 1: fuld URL (foretrækkes)
LOKAL_DB_URL=""

# Mulighed 2: felt-for-felt (bruges kun hvis LOKAL_DB_URL ikke er sat).
# Alle fem felter skal være udfyldt, ellers fejler local_sqlalchemy_url().
LOKAL_DB="localhost"
LOKAL_DB_PORT="1433"
# Brug en dedikeret konto med rettigheder til kun denne database – ikke 'sa'.
LOKAL_DB_BRUGERNAVN="konsido_etl"
LOKAL_DB_ADGANGSKODE="<indsæt-adgangskode>"
LOKAL_DB_NAVN="konsido"

# Skema i den lokale database, som tabellerne skrives til
LOCAL_DEST_SCHEMA_DEFAULT="dbo"

LOCAL_ODBC_DRIVER="ODBC Driver 17 for SQL Server"
# Anbefalet: "yes" mod en server med et gyldigt certifikat. Står som "no",
# fordi en lokal SQL Server typisk har et selvsigneret certifikat – slår du
# ENCRYPT til, skal TRUST_SERVER_CERTIFICATE også være "yes".
LOCAL_ENCRYPT="no"
LOCAL_TRUST_SERVER_CERTIFICATE="no"
LOCAL_TRUSTED_CONNECTION="no"

# ────────────────
# ETL settings
# ────────────────
ETL_CHUNKSIZE=100000
ETL_OVERWRITE_MODE=TRUNCATE   # TRUNCATE eller DROP_CREATE

# Retry ved midlertidige DB-fejl (fx "SHUTDOWN IS IN PROGRESS" ved genstart).
# Hvert forsøg forbereder destinationen forfra, så delvise loads ikke duplikerer.
ETL_MAX_RETRIES=2
ETL_RETRY_BASE_DELAY_SECONDS=300   # lineær backoff: 300s, 600s, …
ETL_RETRY_MAX_DELAY_SECONDS=900    # men aldrig mere end dette

# ────────────────
# Logging
# ────────────────
LOG_LEVEL=INFO
# Gem log i fil ud over konsol. Bemærk: logfiler kan indeholde
# person- og økonomioplysninger – de ligger derfor i .gitignore.
# LOG_FILE=logs/konsido-etl.log
